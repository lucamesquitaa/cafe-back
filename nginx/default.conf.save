server {
    listen 80;
    server_name api.Cafeteria.com.br;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name api.Cafeteria.com.br;

    ssl_certificate /etc/letsencrypt/live/api.Cafeteria.com.br/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.Cafeteria.com.br/privkey.pem;

location / {

    # CORS
    add_header 'Access-Control-Allow-Origin' 'https://www.Cafeteria.com.br' always;
    add_header 'Access-Control-Allow-Methods' 'GET, POST, PUT, DELETE, OPTIONS' always;
    add_header 'Access-Control-Allow-Headers' 'Authorization,Content-Type' always;

    # Preflight
    if ($request_method = OPTIONS) {
        return 204;
    }

    proxy_pass http://Cafeteria_local:8080/;

    proxy_http_version 1.1;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "keep-alive";
}location / {

    # CORS
    add_header 'Access-Control-Allow-Origin' 'https://www.Cafeteria.com.br' always;
    add_header 'Access-Control-Allow-Methods' 'GET, POST, PUT, DELETE, OPTIONS' always;
    add_header 'Access-Control-Allow-Headers' 'Authorization,Content-Type' always;

    # Preflight
    if ($request_method = OPTIONS) {
        return 204;
    }

    proxy_pass http://Cafeteria_local:8080/;

    proxy_http_version 1.1;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "keep-alive";
}
}
